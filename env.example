# Copy to .env.local. Every value here is a public address, not a secret.

# Gala's own Convex project (written by `npx convex dev`).
VITE_CONVEX_URL=

# Frilly's sign-in: the Convex deployment Gala's accounts live on.
VITE_FRILLY_SITE_URL=
VITE_FRILLY_CONVEX_URL=
# Frilly's dashboard, for "Forgot password?" (https://dev.frillyconcierge.com on dev, https://frillyconcierge.com in production).
VITE_FRILLY_APP_URL=

# ---------------------------------------------------------------------------
# Gala's server (the engine). These are read on the Sprite from
# /home/sprite/gala.env, a file the deploy never touches. Copy the four
# lines there and fill them in.

# The two Sprites connectors. They answer only from inside the Sprite and
# take no auth header, so there is no model key in this project.
GALA_GEMINI_URL=
GALA_TYPESAFE_URL=

# Gala's storage: the HTTP address of the Convex deployment (https://<name>.convex.site).
GALA_CONVEX_SITE_URL=

# Shared with the Convex deployment, where it is set under the same name.
# It proves a call comes from this server. Without it the engine runs on
# the public stand-in prompt and cannot reach storage.
GALA_SERVER_SECRET=
