{
  "name": "frilly-gala",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Gala, a logo design agent on Fly.io Sprites. The persona prompt is withheld.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p convex/tsconfig.json && tsc -p engine/tsconfig.json",
    "start": "node server/index.mjs",
    "smoke": "node scripts/smoke.mjs",
    "gate": "node scripts/visual-gate.mjs",
    "check:guard": "node --experimental-strip-types --no-warnings engine/checks/guard.check.ts",
    "check:jev": "node --experimental-strip-types --no-warnings engine/checks/jev.check.ts",
    "check:e2e": "node --experimental-strip-types --no-warnings engine/checks/e2e.ts",
    "check:history": "node scripts/check-history.mjs",
    "check:storage": "node scripts/check-storage.mjs",
    "check:walk": "node --experimental-strip-types --no-warnings engine/checks/walk.check.ts",
    "check:turn": "node scripts/check-turn.mjs",
    "check:routes": "node --experimental-strip-types --no-warnings engine/checks/routes.check.ts",
    "check:backdrops": "node scripts/check-backdrops.mjs",
    "measure:backdrops": "node scripts/measure-backdrops.mjs"
  },
  "dependencies": {
    "@convex-dev/better-auth": "0.8.6",
    "better-auth": "1.3.8",
    "convex": "^1.51.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "postcss": "^8.5.33",
    "puppeteer-core": "^25.18.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^8.3.8"
  },
  "overrides": {
    "@better-fetch/fetch": "1.1.18"
  }
}
