{
  "name": "frilly-gala",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Gala, a logo design agent on Fly.io Sprites. The persona prompt is withheld.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p convex/tsconfig.json && tsc -p engine/tsconfig.json",
    "start": "node server/index.mjs",
    "smoke": "node scripts/smoke.mjs",
    "gate": "node scripts/visual-gate.mjs",
    "check:guard": "node --experimental-strip-types --no-warnings engine/checks/guard.check.ts",
    "check:jev": "node --experimental-strip-types --no-warnings engine/checks/jev.check.ts",
    "check:e2e": "node --experimental-strip-types --no-warnings engine/checks/e2e.ts",
    "check:history": "node scripts/check-history.mjs",
    "check:storage": "node scripts/check-storage.mjs",
    "check:walk": "node --experimental-strip-types --no-warnings engine/checks/walk.check.ts",
    "check:turn": "node scripts/check-turn.mjs",
    "check:steps-walk": "node scripts/check-steps-walk.mjs",
    "check:research": "node --experimental-strip-types --no-warnings engine/checks/research.check.ts",
    "check:steer": "node --experimental-strip-types --no-warnings engine/checks/steer.check.ts",
    "check:held": "node --experimental-strip-types --no-warnings engine/checks/held.check.ts",
    "check:held-reaches": "node --experimental-strip-types --no-warnings engine/checks/held-reaches.check.ts",
    "check:gate": "node --experimental-strip-types --no-warnings engine/checks/gate.check.ts",
    "check:settings": "node --experimental-strip-types --no-warnings engine/checks/settings.check.ts",
    "check:nosymbol": "node --experimental-strip-types --no-warnings engine/checks/nosymbol.check.ts",
    "check:typeset": "node --experimental-strip-types --no-warnings engine/checks/typeset.check.ts",
    "check:wordmark-fonts": "node --experimental-strip-types --no-warnings engine/checks/wordmark-fonts.check.ts",
    "check:cards": "node --experimental-strip-types --no-warnings engine/checks/cards.check.ts",
    "check:cards-drawn": "node scripts/check-cards.mjs",
    "check:weight": "node --experimental-strip-types --no-warnings engine/checks/weight.check.ts",
    "check:feedback-walk": "node --experimental-strip-types --no-warnings scripts/check-feedback-walk.mjs",
    "check:failures": "node --experimental-strip-types --no-warnings engine/checks/failures.check.ts",
    "check:failures-drawn": "node scripts/check-failures.mjs",
    "check:feedback": "node --experimental-strip-types --no-warnings engine/checks/feedback.check.ts",
    "check:feedback-drawn": "node scripts/check-feedback-drawn.mjs",
    "check:states": "node scripts/check-states.mjs",
    "check:kit-first": "node --experimental-strip-types --no-warnings engine/checks/kit-first.check.ts",
    "check:routes": "node --experimental-strip-types --no-warnings engine/checks/routes.check.ts",
    "check:earlier-cards": "node --experimental-strip-types --no-warnings engine/checks/earlier-cards.check.ts",
    "sweep:fonts": "node --experimental-strip-types --no-warnings engine/checks/font-sweep.ts",
    "check:backdrops": "node scripts/check-backdrops.mjs",
    "measure:backdrops": "node scripts/measure-backdrops.mjs"
  },
  "dependencies": {
    "@convex-dev/better-auth": "0.8.6",
    "better-auth": "1.3.8",
    "convex": "^1.51.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "postcss": "^8.5.33",
    "puppeteer-core": "^25.18.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^8.3.8"
  },
  "overrides": {
    "@better-fetch/fetch": "1.1.18"
  }
}
