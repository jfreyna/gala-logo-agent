{
  "name": "@frilly-gala/kit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Gala's kit pipeline: a mark, a Google font and brand colors in; lock-ups (SVG, EPS, PNG), the square, the social image and the spec sheet out.",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:color": "node --experimental-strip-types --no-warnings scripts/verify-color.ts",
    "verify:kit": "node --experimental-strip-types --no-warnings scripts/verify-kit.ts",
    "verify": "npm run verify:color && npm run verify:kit",
    "fixture": "node --experimental-strip-types --no-warnings scripts/fixture.ts"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "harfbuzzjs": "1.6.4",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0",
    "potrace": "2.1.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pngjs": "6.0.5",
    "fast-xml-parser": "5.12.1",
    "typescript": "5.6.3"
  },
  "overrides": {
    "phin": "^3.7.1"
  }
}
